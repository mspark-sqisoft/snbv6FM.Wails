{
  "name": "snbapp-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.mjs",
    "check:designs": "node scripts/check-designs.mjs",
    "check:dialogs": "node --experimental-strip-types scripts/check-dialogs.mjs"
  },
  "dependencies": {
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/svelte": "^1.65.0",
    "@wailsio/runtime": "3.0.0",
    "galmuri": "^2.40.3",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.46.4",
    "svelte-check": "^4.4.8",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^8.2.4"
  }
}
